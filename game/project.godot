; Project configuration. Approved runtime pin: Godot 4.7.2.
config_version=5

[application]
config/name="Cyberpunk 3D — Feasibility"
run/main_scene="res://tests/scenes/combat_feedback.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]
InteriorTransition="*res://world/interior_transition.gd"

[display]
window/size/viewport_width=960
window/size/viewport_height=540
window/size/mode=3

[gui]
theme/custom="res://ui/cyberpunk_theme.tres"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.025, 0.035, 0.055, 1)
