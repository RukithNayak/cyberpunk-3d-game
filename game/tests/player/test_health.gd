extends RefCounted


func run(check: Callable) -> void:
	var script: Script = load("res://features/player/health_state.gd")
	var health: RefCounted = script.new(100)
	var events: Dictionary = {"deaths": 0, "changes": 0}
	health.on_death.connect(func() -> void: events["deaths"] += 1)
	health.health_changed.connect(func(_current: int, _maximum: int) -> void: events["changes"] += 1)
	check.call(health.current_hp == 100 and health.max_hp == 100, "health starts full at configured maximum")
	health.apply_damage(30, "test")
	check.call(health.current_hp == 70, "positive damage reduces health")
	health.apply_damage(-10, "test")
	health.apply_damage(0, "test")
	check.call(health.current_hp == 70 and events["changes"] == 1, "nonpositive damage has no effect or event")
	health.heal(-5)
	health.heal(0)
	check.call(health.current_hp == 70, "nonpositive healing has no effect")
	health.heal(9223372036854775807)
	check.call(health.current_hp == 100, "extreme healing clamps without overflow")
	health.apply_damage(9223372036854775807, "test")
	check.call(health.current_hp == 0 and health.is_dead(), "extreme damage clamps at death")
	check.call(events["deaths"] == 1, "lethal damage emits one death")
	health.apply_damage(1, "test")
	health.apply_damage(9223372036854775807, "test")
	health.heal(100)
	check.call(health.current_hp == 0 and events["deaths"] == 1, "dead actor cannot heal or emit repeated deaths")
	check.call(not health.restore(101, 100), "restore rejects health beyond maximum")
	check.call(not health.restore(1, 0), "restore rejects zero maximum")
	check.call(not health.restore(1, -1), "restore rejects negative maximum")
	check.call(not health.restore(-1, 100), "restore rejects negative health")
	check.call(health.current_hp == 0 and health.max_hp == 100, "invalid restore leaves state unchanged")
	check.call(health.restore(40, 80), "explicit checkpoint restore accepts valid state")
	check.call(health.current_hp == 40 and health.max_hp == 80 and not health.is_dead(), "restore applies health and maximum together")
	health.heal(10)
	check.call(health.current_hp == 50, "living actor can heal")
	health.apply_damage(50, "test")
	check.call(events["deaths"] == 2, "death event resets after explicit living restore")
	var invalid: RefCounted = script.new(0)
	check.call(invalid.max_hp == 100 and invalid.current_hp == 100, "invalid initial maximum falls back to documented default")
	var huge: RefCounted = script.new(9223372036854775807)
	huge.apply_damage(1, "test")
	huge.heal(9223372036854775807)
	check.call(huge.current_hp == huge.max_hp, "maximum integer health heals safely")
